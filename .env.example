# Database
DATABASE_URL=sqlite:///./ffaa.db

# Auth (fastapi-users, P1 multi-tenant)
FFAA_SECRET=change-me-to-a-long-random-string   # JWT signing + reset tokens; REQUIRED in production
FFAA_COOKIE_SECURE=false                        # true behind https in production
FFAA_OPERATOR_EMAIL=operator@ffaa.local         # operator account created by scripts/migrate_multi_tenant.py

# Client folder hierarchy root
FFAA_CLIENT_ROOT=./data/clients

# PaddleOCR Windows CPU (set before process start; also set in ocr.py)
FLAGS_enable_pir_api=0
FLAGS_use_mkldnn=0

# SMTP for client reminders
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# NOTE: threshold constants are hardcoded, not env-configurable:
#   Reconciliation (app/reconcile.py): amount tolerance ±0.05, date window 3 days, min auto-match score 0.55
#   Duplicate detection (app/duplicates.py): similarity threshold 80.0, date window 7 days

# Reserved: enforced by upload endpoints (review finding F-15 work)
MAX_FILE_SIZE_MB=50
