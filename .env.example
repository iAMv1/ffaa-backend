# Database
DATABASE_URL=sqlite:///./ffaa.db

# Client folder hierarchy root
FFAA_CLIENT_ROOT=./data/clients

# PaddleOCR Windows CPU (set before process start; also set in ocr.py)
FLAGS_enable_pir_api=0
FLAGS_use_mkldnn=0

# SMTP for client reminders
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# Reconciliation
MATCH_SCORE_THRESHOLD=0.55
DATE_TOLERANCE_DAYS=3
NARRATION_SIMILARITY_THRESHOLD=0.75

# File upload
MAX_FILE_SIZE_MB=50
