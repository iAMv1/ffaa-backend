# Database
DATABASE_URL=sqlite:///./ffaa.db

# Auth (fastapi-users, P1 multi-tenant)
FFAA_SECRET=change-me-to-a-long-random-string   # JWT signing + reset tokens; REQUIRED in production
FFAA_COOKIE_SECURE=false                        # true behind https in production
FFAA_OPERATOR_EMAIL=operator@ffaa.local         # operator account created by scripts/migrate_multi_tenant.py

# Client folder hierarchy root
FFAA_CLIENT_ROOT=./data/clients

# PaddleOCR Windows CPU (set before process start; also set in ocr.py)
FLAGS_enable_pir_api=0
FLAGS_use_mkldnn=0

# SMTP for client reminders
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# Razorpay billing (P4). Absent keys → /api/v1/billing/order returns 503
# "payments not configured". Use test-mode keys from the Razorpay dashboard;
# WEBHOOK_SECRET is set per-webhook-subscription in the same dashboard.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# NOTE: threshold constants are hardcoded, not env-configurable:
#   Reconciliation (app/reconcile.py): amount tolerance ±0.05, date window 3 days, min auto-match score 0.55
#   Duplicate detection (app/duplicates.py): similarity threshold 80.0, date window 7 days

# Reserved: enforced by upload endpoints (review finding F-15 work)
MAX_FILE_SIZE_MB=50

# Social login (optional). Create credentials at:
#   Google: console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web)
#           Authorized redirect URI: http://localhost:5173/api/v1/auth/google/callback
#   GitHub: github.com/settings/developers → New OAuth App
#           Callback URL: http://localhost:5173/api/v1/auth/github/callback
# Buttons for configured providers appear automatically on Login/Register.
# GOOGLE_OAUTH_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=xxx
# GITHUB_OAUTH_CLIENT_ID=xxx
# GITHUB_OAUTH_CLIENT_SECRET=xxx
# FFAA_PUBLIC_URL=http://localhost:5173

# --- OCR escalation cost control (free tier: $10-20 Datalab credits/month) ---
# Escalation mode default is "fast" ($6/1k pages); balanced/accurate cost more.
# FFAA_OCR_ESCALATION_BUDGET caps cloud-escalated pages per calendar month
# (counter resets automatically each month; 0/unset = unlimited).
# FFAA_OCR_ESCALATION=datalab
# DATALAB_API_KEY=
# FFAA_OCR_DATALAB_MODE=fast
# FFAA_OCR_ESCALATION_CONF=0.5
# FFAA_OCR_ESCALATION_BUDGET=1200
# FFAA_OCR_ESCALATION_USAGE=.escalation_usage.json
# Agentic cost ladder: tiers ascend fast->balanced->accurate ONLY when
# verification fails; default single tier keeps cost at parity.
# FFAA_OCR_ESCALATION_TIERS=fast,balanced,accurate
# FFAA_OCR_ESCALATION_CACHE=.escalation_cache.json
